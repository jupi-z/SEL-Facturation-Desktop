<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="SEL Facturation" Manufacturer="Société d'Énergie du Lualaba" Version="$(var.ProductVersion)" UpgradeCode="C84DF0E9-3C3B-4C54-8A31-B2B3C28B94CF" IconSourceFile="$(var.IconPath)">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseUrl="" Theme="hyperlinkLicense" ShowVersion="yes" />
    </BootstrapperApplication>
    <bal:Condition Condition="NOT LegacyInnoDetected OR LegacyInnoVersion" Message="Une installation héritée de SEL Facturation est détectée sans version exploitable. La migration automatique (LegacyInnoCleanup) est bloquée pour protéger les données." />
    <util:RegistrySearch Id="LegacyInnoDetectedSearch" Variable="LegacyInnoDetected" Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{7B258C72-AE0B-4D4E-84DE-725C08F20EA1}_is1" Result="exists" />
    <util:RegistrySearch Id="LegacyInnoVersionSearch" Variable="LegacyInnoVersion" Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{7B258C72-AE0B-4D4E-84DE-725C08F20EA1}_is1" Value="DisplayVersion" Result="value" />
    <util:RegistrySearch Id="WebView2RuntimeVersion" Variable="WebView2RuntimeVersion" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00A7DCCB54E5}" Value="pv" Result="value" />
    <Chain>
      <ExePackage Id="LegacyInnoCleanup" SourceFile="$(var.LegacyCleanupPath)" DisplayName="Migration de l'ancienne installation SEL" Permanent="yes" Vital="yes" DetectCondition="NOT LegacyInnoDetected" InstallArguments="--cleanup-legacy --current-version &quot;[WixBundleVersion]&quot;" />
        <ExePackage Id="WebView2EvergreenStandalone" SourceFile="$(var.WebView2Installer)" PerMachine="yes" Permanent="yes" DetectCondition="WebView2RuntimeVersion" InstallArguments="/silent /install">
      </ExePackage>
      <MsiPackage SourceFile="$(var.MsiPath)" />
    </Chain>
  </Bundle>
</Wix>
